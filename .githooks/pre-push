#!/bin/sh
# Lints and tests the code before anything leaves your machine.
# Enable once per clone with: git config core.hooksPath .githooks
set -e

if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "pre-push: golangci-lint is required, install it with:" >&2
	echo "  go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest" >&2
	exit 1
fi

echo "pre-push: linting"
golangci-lint run ./...
echo "pre-push: testing"
go test -race ./...
